# Required
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Public site and allowed browser origins (comma separated)
SITE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Parent sign-in via Supabase Auth. With none of these set, family endpoints are off.
# Current Supabase projects sign with ES256: set the key-set URL and issuer.
AUTH_JWKS_URL=
AUTH_JWT_ISSUER=
# Only for projects that still use the legacy shared secret.
AUTH_JWT_SECRET=
AUTH_JWT_AUDIENCE=authenticated

# Email via Resend. Empty = emails are logged, not sent.
RESEND_API_KEY=
EMAIL_FROM=CampFinder <hello@yourdomain.com>
TEAM_EMAIL=

# Listing ingest (python -m campfinder.ingest). Read by the Anthropic SDK.
ANTHROPIC_API_KEY=
INGEST_MODEL=claude-opus-5-5

# Abuse limits
RATE_LIMIT_PER_MINUTE=30

PRIVACY_POLICY_VERSION=2026-10
