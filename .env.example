# Required
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Public site and allowed browser origins (comma separated)
SITE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Parent sign-in. New Supabase projects sign with asymmetric keys: set AUTH_JWKS_URL to
# https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json. AUTH_JWT_SECRET is only for
# projects still on the legacy shared secret. Both empty = family endpoints off.
AUTH_JWKS_URL=
AUTH_JWT_SECRET=
AUTH_JWT_AUDIENCE=authenticated

# Email via Resend. Empty = emails are logged, not sent.
RESEND_API_KEY=
EMAIL_FROM=CampFinder <hello@yourdomain.com>
TEAM_EMAIL=

# Listing ingest (python -m campfinder.ingest). Read by the Anthropic SDK.
ANTHROPIC_API_KEY=
INGEST_MODEL=claude-opus-5-5

# Abuse limits
RATE_LIMIT_PER_MINUTE=30

PRIVACY_POLICY_VERSION=2026-10
